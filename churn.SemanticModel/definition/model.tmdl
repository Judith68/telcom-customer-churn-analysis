model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Telcom","Key Measures"]

annotation PBI_ProTooling = ["CopilotTooling","DaxQueryView_Desktop","TMDLView_Desktop","DevMode"]

ref table Telcom
ref table 'Key Measures'

ref cultureInfo en-US

