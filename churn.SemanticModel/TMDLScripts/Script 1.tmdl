			annotation SummarizationSetBy = Automatic

		column 'Tenure Group' =
				
				SWITCH(
				    TRUE(),
				    Telcom[tenure] <= 6, "0–6 Months",
				    Telcom[tenure] <= 12, "7–12 Months",
				    Telcom[tenure] <= 24, "13–24 Months",
				    Telcom[tenure] <= 48, "25–48 Months",
				    Telcom[tenure] <= 72, "49–72 Months",
				    "Unknown"
				)
			lineageTag: b242a92e-38a3-4c1f-a62d-4c8cbf084afc
			summarizeBy: none

			annotation SummarizationSetBy = Automatic

		column 'Tenure Group Sort' =
				
				SWITCH(
				    Telcom[Tenure Group],
				    "0–6 Months", 1,
				    "7–12 Months", 2,
				    "13–24 Months", 3,
				    "25–48 Months", 4,
				    "49–72 Months", 5,
				    6
				)
			formatString: 0
			lineageTag: 97fca332-9840-4d59-bdeb-f69d38d9f6d4
			summarizeBy: sum

			changedProperty = SortByColumn

			annotation SummarizationSetBy = Automatic

		column 'Monthly Charge Group' =
				
				SWITCH(
				    TRUE(),
				    'Telcom'[MonthlyCharges] < 30, "Under $30",
				    'Telcom'[MonthlyCharges] < 60, "$30–$60",
				    'Telcom'[MonthlyCharges] < 90, "$60–$90",
				    'Telcom'[MonthlyCharges] < 120, "$90–$120",
				    "$120+"
				)
			lineageTag: 1c9c1b6c-f395-43c2-876b-232fd3510b39
			summarizeBy: none

			annotation SummarizationSetBy = Automatic

		column 'Monthly Charge Group Sort' =
				
				SWITCH(
				    TRUE(),
				    'Telcom'[MonthlyCharges] < 30, 1,
				    'Telcom'[MonthlyCharges] < 60, 2,
				    'Telcom'[MonthlyCharges] < 90, 3,
				    'Telcom'[MonthlyCharges] < 120, 4,
				    5
				)
			formatString: 0
			lineageTag: f2c9f003-d592-4968-b7db-0389036c7334
			summarizeBy: sum

			annotation SummarizationSetBy = Automatic

